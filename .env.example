# Used only by the local OAuth helper (src/linkedin_bot/auth/oauth_helper.py).
# Copy to .env and fill in. Never commit .env.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional; must match a redirect URL registered in the LinkedIn app's Auth tab.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# Optional; proxy for the helper's own HTTP calls (system proxy settings are ignored).
# Example for a local VPN client (check its HTTP/mixed port): http://127.0.0.1:12334
LINKEDIN_AUTH_PROXY=

# --- GitHub Actions secrets (never set locally; listed here for completeness) ---
# LINKEDIN_ACCESS_TOKEN=    from .linkedin_token.json, expires every 60 days
# LINKEDIN_MEMBER_URN=      urn:li:person:<id>, printed by the auth helper
# GROQ_API_KEY=             Groq API key for the generator (D-024)
# Optional override of the Linkedin-Version header (YYYYMM); default in linkedin_client.py
# LINKEDIN_API_VERSION=
